rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // LRN folders: name (1-80 characters), kind (batch/class), createdAt.
    // Master records retain their document ID and immutable registration link.
    // folderId is optional for legacy records; '' means Unfiled.
    // archived=true hides a registered LRN without releasing its identity.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }
    function isAdminProfile() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true;
    }
    function canAdmin() {
      return isAdmin() || isAdminProfile();
    }
    function isActiveTeacher() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true;
    }
    function ownsClass(classId) {
      return classId is string && classId.size() > 0 && classId.size() <= 128
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }
    function validFolder(data) {
      return data.keys().hasOnly(['name', 'kind', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.kind is string && data.kind in ['batch', 'class']
        && data.createdAt is timestamp;
    }
    function validFolderId(data) {
      return data.get('folderId', '') is string
        && data.get('folderId', '').size() <= 128
        && (data.get('folderId', '') == ''
          || exists(/databases/$(database)/documents/lrn_folders/$(data.folderId)));
    }
    function validMaster(data, lrn) {
      return lrn.matches('^[0-9]{12}$')
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 150
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 150
        && data.get('middleName', '') is string && data.get('middleName', '').size() <= 150
        && data.get('extension', '') is string && data.get('extension', '').size() <= 30
        && data.get('suffix', '') is string && data.get('suffix', '').size() <= 30
        && data.get('middleInitial', '') is string && data.get('middleInitial', '').size() <= 150
        && data.isRegistered is bool
        && data.get('archived', false) is bool
        && validFolderId(data);
    }
    // Middle initials use middleName; suffix uses extension. Legacy aliases
    // remain readable. These optional fields retain the same Admin-only writer.
    function matchesSchoolIdentity(profile, master) {
      return profile.firstName == master.firstName && profile.lastName == master.lastName
        && profile.get('middleName', '') == master.get('middleName', master.get('middleInitial', ''))
        && profile.get('extension', '') == master.get('extension', master.get('suffix', ''));
    }
    function hasLrn(data) {
      return data.get('lrn', '') is string && data.get('lrn', '').matches('^[0-9]{12}$');
    }
    function officialProfile(data, uid) {
      let master = getAfter(/databases/$(database)/documents/lrn_master_list/$(data.lrn)).data;
      return request.auth.uid == uid && data.uid == uid && data.role == 'student'
        && master.isRegistered == true && master.registeredUid == uid
        && matchesSchoolIdentity(data, master);
    }
    // Only assigned active teachers can provision student profiles.
    // Admin account creation is limited to teachers and trainers.
    function profileCreate(data, uid) {
      return (isAdminProfile() && data.role in ['teacher', 'trainer'])
        || invitedStudentProfile(data, uid);
    }
    function invitedStudentProfile(data, uid) {
      return isActiveTeacher() && ownsClass(data.invitedClassId)
        && data.keys().hasOnly([
          'uid', 'email', 'role', 'firstName', 'lastName', 'name',
          'displayName', 'invitationStatus', 'invitedAt', 'invitedBy',
          'invitedClassId', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid && data.role == 'student'
        && data.invitedBy == request.auth.uid
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.firstName is string && data.firstName.size() <= 80
        && data.lastName is string && data.lastName.size() <= 80
        && data.name is string && data.name.size() > 0 && data.name.size() <= 161
        && data.displayName == data.name
        && data.invitationStatus == 'pending'
        && data.invitedAt == request.time
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function profileUpdate(uid) {
      return (isAdminProfile()
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('uid', uid) == resource.data.get('uid', uid))
        || (request.auth != null && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'uid', 'role', 'lrn', 'firstName', 'middleName', 'middleInitial',
              'lastName', 'extension', 'suffix', 'name', 'displayName',
              'isActive', 'accessRevokedAt', 'accessRevokedBy',
              'invitationStatus', 'invitedAt', 'invitedBy', 'invitedClassId']));
    }
    function claimsLrn(lrn) {
      let after = request.resource.data;
      let user = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let student = getAfter(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return resource.data.isRegistered == false
        && resource.data.get('archived', false) == false
        && after.diff(resource.data).affectedKeys().hasOnly(['isRegistered', 'registeredAt', 'registeredUid'])
        && after.isRegistered == true && after.registeredUid == request.auth.uid
        && after.registeredAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && user.uid == request.auth.uid && user.role == 'student' && user.lrn == lrn
        && user.firstName == resource.data.firstName && user.lastName == resource.data.lastName
        && matchesSchoolIdentity(user, resource.data)
        && student == user;
    }
    match /lrn_folders/{folder} {
      allow read: if canAdmin();
      // Retired registration namespace: preserve historical records only.
      allow write: if false;
    }
    match /lrn_master_list/{lrn} {
      // LRN master data contains school-managed identity information.
      allow get: if canAdmin();
      allow list: if canAdmin();
      allow write: if false;
    }

    // Narrow the previous signed-in catch-all: registered student names cannot
    // be edited, deleted/recreated, or relabeled to evade identity protection.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if profileCreate(request.resource.data, uid);
      allow update: if profileUpdate(uid);
      allow delete: if canAdmin();
    }
    match /students/{uid} {
      allow read: if request.auth != null;
      allow create: if invitedStudentProfile(request.resource.data, uid);
      allow update: if profileUpdate(uid);
      allow delete: if canAdmin();
    }
    match /users/{uid}/classes/{classId} {
      allow read: if request.auth != null;
      allow create, update: if canAdmin() || (
        request.auth != null
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'student'
        && (request.auth.uid == uid || (isActiveTeacher() && ownsClass(classId)))
        && request.resource.data.classId == classId
        && uid in getAfter(/databases/$(database)/documents/classes/$(classId)).data.enrolledStudentIds
      );
      allow delete: if canAdmin() || (request.auth != null
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'student'
        && (request.auth.uid == uid || (isActiveTeacher() && ownsClass(classId))));
    }
    match /users/{uid}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null && subcollection != 'classes';
    }
    match /students/{uid}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null;
    }
    // CSS gradebooks are scoped to the authenticated teacher, never client-
    // supplied ownership. Profiles are immutable once configured. Records store
    // component totals; computed grades are derived using the versioned policy.
    function gradebookOwner(teacherId) {
      return request.auth != null && request.auth.uid == teacherId && isActiveTeacher();
    }
    function validGradeScore(score) {
      return score is map && score.keys().hasAll(['raw', 'maximum'])
        && score.keys().hasOnly(['raw', 'maximum'])
        && score.raw is number && score.maximum is number
        && score.maximum > 0 && score.maximum <= 1000000
        && score.raw >= 0 && score.raw <= score.maximum;
    }
    function validGradeScores(scores) {
      return scores is map && scores.keys().hasOnly(['ww', 'pt', 'st1', 'st2', 'te'])
        && (!('ww' in scores) || validGradeScore(scores.ww))
        && (!('pt' in scores) || validGradeScore(scores.pt))
        && (!('st1' in scores) || validGradeScore(scores.st1))
        && (!('st2' in scores) || validGradeScore(scores.st2))
        && (!('te' in scores) || validGradeScore(scores.te));
    }
    match /css_gradebooks/{teacherId}/classes/{classId} {
      allow read: if gradebookOwner(teacherId);
      allow create: if gradebookOwner(teacherId) && ownsClass(classId)
        && request.resource.data.keys().hasOnly(['profile', 'year', 'updatedAt'])
        && request.resource.data.profile == 'techPro'
        && request.resource.data.year is int
        && request.resource.data.year >= 2026 && request.resource.data.year <= 2100
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
      match /records/{recordId} {
        allow read: if gradebookOwner(teacherId);
        allow create, update: if gradebookOwner(teacherId) && ownsClass(classId)
          && exists(/databases/$(database)/documents/css_gradebooks/$(teacherId)/classes/$(classId))
          && request.resource.data.keys().hasOnly(['studentId', 'term', 'scores', 'updatedAt'])
          && request.resource.data.studentId is string
          && request.resource.data.studentId.size() > 0 && request.resource.data.studentId.size() <= 128
          && request.resource.data.studentId in get(/databases/$(database)/documents/classes/$(classId)).data.enrolledStudentIds
          && request.resource.data.term is int && request.resource.data.term in [1, 2, 3]
          && recordId == request.resource.data.studentId + '_' + string(request.resource.data.term)
          && validGradeScores(request.resource.data.scores)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }
    function validClassRoster(data) {
      return data.enrolledStudentIds is list && data.enrolledStudentIds.size() <= 1000
        && data.get('description', '') is string && data.get('description', '').size() <= 5000
        && data.get('studentCount', 0) is int && data.get('studentCount', 0) >= 0 && data.get('studentCount', 0) <= 1000
        && data.get('pendingReviews', 0) is int && data.get('pendingReviews', 0) >= 0;
    }
    function validPrincipalClass(data) {
      return validClassRoster(data) && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.sectionCode is string && data.sectionCode.size() > 0 && data.sectionCode.size() <= 60
        && data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 128
        && get(/databases/$(database)/documents/users/$(data.teacherId)).data.role == 'teacher'
        && data.schoolYear is string && data.schoolYear.size() > 0 && data.schoolYear.size() <= 32
        && data.status in ['active', 'archived']
        && data.enrolledStudentIds is list && data.enrolledStudentIds.size() <= 1000
        && data.get('trainerIds', []) is list && data.get('trainerIds', []).size() <= 100;
    }
    function classParticipant(classId) {
      let classroom = get(/databases/$(database)/documents/classes/$(classId)).data;
      return request.auth != null && (canAdmin() || (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
        && (classroom.teacherId == request.auth.uid
          || request.auth.uid in classroom.get('trainerIds', [])
          || request.auth.uid in classroom.get('enrolledStudentIds', []))));
    }
    function classStaff(classId) {
      let classroom = get(/databases/$(database)/documents/classes/$(classId)).data;
      return request.auth != null && (canAdmin()
        || (isActiveTeacher() && classroom.teacherId == request.auth.uid)
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
          && request.auth.uid in classroom.get('trainerIds', [])));
    }
    function studentJoinsSelf() {
      let before = resource.data.get('enrolledStudentIds', []);
      let after = request.resource.data.enrolledStudentIds;
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudentIds', 'updatedAt'])
        && after is list && after.size() <= 1000
        && after.size() == after.toSet().size()
        && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
        && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create: if canAdmin() && validPrincipalClass(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && (
        (canAdmin() && validPrincipalClass(request.resource.data))
        || (isActiveTeacher() && ownsClass(classId) && validClassRoster(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'description', 'enrolledStudentIds', 'studentCount', 'pendingReviews', 'updatedAt']))
        || studentJoinsSelf());
      allow delete: if canAdmin();
      match /forum_posts/{document=**} {
        allow read, write: if classParticipant(classId);
      }
      match /module_access/{accessId} {
        allow read: if classParticipant(classId);
        allow create, update: if classStaff(classId) || (classParticipant(classId)
          && request.resource.data.studentId == request.auth.uid);
        allow delete: if classStaff(classId);
      }
      match /{subcollection}/{document=**} {
        allow read: if classParticipant(classId);
        allow write: if classStaff(classId);
      }
    }
    // Existing policies for unrelated collections remain unchanged. Exclude the
    // LRN namespace here so a broad match cannot bypass its admin restrictions.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && !(collection in ['lrn_master_list', 'lrn_folders', 'users', 'students', 'css_gradebooks', 'classes']);
    }
  }
}
