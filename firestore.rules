rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // LRN folders: name (1-80 characters), kind (batch/class), createdAt.
    // Master records retain their document ID and immutable registration link.
    // folderId is optional for legacy records; '' means Unfiled.
    // archived=true hides a registered LRN without releasing its identity.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }
    function isAdminProfile() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true;
    }
    function canAdmin() {
      return isAdmin() || isAdminProfile();
    }
    function isActiveTeacher() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true;
    }
    function ownsClass(classId) {
      return classId is string && classId.size() > 0 && classId.size() <= 128
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherId == request.auth.uid;
    }
    function validFolder(data) {
      return data.keys().hasOnly(['name', 'kind', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.kind is string && data.kind in ['batch', 'class']
        && data.createdAt is timestamp;
    }
    function validFolderId(data) {
      return data.get('folderId', '') is string
        && data.get('folderId', '').size() <= 128
        && (data.get('folderId', '') == ''
          || exists(/databases/$(database)/documents/lrn_folders/$(data.folderId)));
    }
    function validMaster(data, lrn) {
      return lrn.matches('^[0-9]{12}$')
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 150
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 150
        && data.get('middleName', '') is string && data.get('middleName', '').size() <= 150
        && data.get('extension', '') is string && data.get('extension', '').size() <= 30
        && data.get('suffix', '') is string && data.get('suffix', '').size() <= 30
        && data.get('middleInitial', '') is string && data.get('middleInitial', '').size() <= 150
        && data.isRegistered is bool
        && data.get('archived', false) is bool
        && validFolderId(data);
    }
    // Middle initials use middleName; suffix uses extension. Legacy aliases
    // remain readable. These optional fields retain the same Admin-only writer.
    function matchesSchoolIdentity(profile, master) {
      return profile.firstName == master.firstName && profile.lastName == master.lastName
        && profile.get('middleName', '') == master.get('middleName', master.get('middleInitial', ''))
        && profile.get('extension', '') == master.get('extension', master.get('suffix', ''));
    }
    function hasLrn(data) {
      return data.get('lrn', '') is string && data.get('lrn', '').matches('^[0-9]{12}$');
    }
    function officialProfile(data, uid) {
      let master = getAfter(/databases/$(database)/documents/lrn_master_list/$(data.lrn)).data;
      return request.auth.uid == uid && data.uid == uid && data.role == 'student'
        && master.isRegistered == true && master.registeredUid == uid
        && matchesSchoolIdentity(data, master);
    }
    // Only assigned active teachers can provision student profiles.
    // Admin account creation is limited to teachers and trainers.
    function profileCreate(data, uid) {
      return (isAdminProfile() && data.role in ['teacher', 'trainer'])
        || invitedStudentProfile(data, uid);
    }
    function invitedStudentProfile(data, uid) {
      return isActiveTeacher() && ownsClass(data.invitedClassId)
        && data.keys().hasOnly([
          'uid', 'email', 'role', 'firstName', 'middleName', 'lastName',
          'extension', 'name',
          'displayName', 'invitationStatus', 'invitedAt', 'invitedBy',
          'invitedClassId', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid && data.role == 'student'
        && data.invitedBy == request.auth.uid
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 80
        && data.middleName is string && data.middleName.size() <= 80
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 80
        && data.extension is string && data.extension.size() <= 30
        && data.name is string && data.name.size() > 0 && data.name.size() <= 274
        && data.displayName == data.name
        && data.invitationStatus == 'pending'
        && data.invitedAt == request.time
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function profileUpdate(uid) {
      return (isAdminProfile()
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('uid', uid) == resource.data.get('uid', uid))
        || (request.auth != null && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'uid', 'role', 'lrn', 'firstName', 'middleName', 'middleInitial',
              'lastName', 'extension', 'suffix', 'name', 'displayName',
              'isActive', 'accessRevokedAt', 'accessRevokedBy',
              'invitationStatus', 'invitedAt', 'invitedBy', 'invitedClassId']));
    }
    function claimsLrn(lrn) {
      let after = request.resource.data;
      let user = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let student = getAfter(/databases/$(database)/documents/students/$(request.auth.uid)).data;
      return resource.data.isRegistered == false
        && resource.data.get('archived', false) == false
        && after.diff(resource.data).affectedKeys().hasOnly(['isRegistered', 'registeredAt', 'registeredUid'])
        && after.isRegistered == true && after.registeredUid == request.auth.uid
        && after.registeredAt == request.time
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && user.uid == request.auth.uid && user.role == 'student' && user.lrn == lrn
        && user.firstName == resource.data.firstName && user.lastName == resource.data.lastName
        && matchesSchoolIdentity(user, resource.data)
        && student == user;
    }
    match /lrn_folders/{folder} {
      allow read: if canAdmin();
      // Retired registration namespace: preserve historical records only.
      allow write: if false;
    }
    match /lrn_master_list/{lrn} {
      // LRN master data contains school-managed identity information.
      allow get: if canAdmin();
      allow list: if canAdmin();
      allow write: if false;
    }

    // Narrow the previous signed-in catch-all: registered student names cannot
    // be edited, deleted/recreated, or relabeled to evade identity protection.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if profileCreate(request.resource.data, uid);
      allow update: if profileUpdate(uid);
      allow delete: if canAdmin();
    }
    match /students/{uid} {
      allow read: if request.auth != null;
      allow create: if invitedStudentProfile(request.resource.data, uid);
      allow update: if profileUpdate(uid);
      allow delete: if canAdmin();
    }
    match /users/{uid}/classes/{classId} {
      allow read: if request.auth != null;
      allow create, update: if canAdmin() || (
        request.auth != null
        // New invitations create this profile and membership in one atomic batch.
        // Read the validated final profile; get() only sees the missing old one.
        && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'student'
        && (request.auth.uid == uid || (isActiveTeacher() && ownsClass(classId)))
        && request.resource.data.classId == classId
        && (request.auth.uid != uid || request.resource.data.classCode
          == getAfter(/databases/$(database)/documents/classes/$(classId)).data.classCode)
        && uid in getAfter(/databases/$(database)/documents/classes/$(classId)).data.enrolledStudentIds
      );
      // Legacy roster entries may have no corresponding user profile.
      // Teachers must also remove the roster ID in the same atomic batch.
      allow delete: if canAdmin() || (request.auth != null && (
        (request.auth.uid == uid
          && get(/databases/$(database)/documents/users/$(uid)).data.role == 'student')
        || (isActiveTeacher() && ownsClass(classId)
          && !(uid in getAfter(/databases/$(database)/documents/classes/$(classId)).data.get('enrolledStudentIds', [])))
      ));
    }
    match /users/{uid}/{subcollection}/{document=**} {
      allow read: if request.auth != null && subcollection != 'classes';
      // Progress belongs to this account. Staff reporting is read-only and
      // must never let one signed-in user overwrite another user's records.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && !(subcollection in ['classes', 'quiz_results', 'module_progress', 'simulation_progress']);
    }
    match /users/{uid}/module_progress/{progressId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.studentId == uid
        && classParticipant(request.resource.data.classId)
        && activeClass(request.resource.data.classId);
      allow delete: if false;
    }
    match /users/{uid}/simulation_progress/{progressId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.studentId == uid
        && classParticipant(request.resource.data.classId)
        && activeClass(request.resource.data.classId);
      allow delete: if false;
    }
    match /users/{uid}/quiz_results/{quizId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.studentId == uid
        && classParticipant(request.resource.data.classId)
        && activeClass(request.resource.data.classId)
        && request.resource.data.quizId == quizId;
      allow update: if request.auth != null && (
        (classStaff(resource.data.classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'retryAllowed', 'teacherFeedback', 'retryAllowedAt', 'attemptNumber'
          ])
          && request.resource.data.retryAllowed == true
          && request.resource.data.teacherFeedback is string
          && request.resource.data.teacherFeedback.size() > 0
          && request.resource.data.teacherFeedback.size() <= 1000
          && request.resource.data.retryAllowedAt is timestamp
          && request.resource.data.attemptNumber is int
          && request.resource.data.attemptNumber >= 1
          && request.resource.data.attemptNumber <= 100)
        ||
        (request.auth.uid == uid
          && resource.data.studentId == uid
          && resource.data.quizId == quizId
          && resource.data.retryAllowed == true
          && request.resource.data.retryAllowed == false
          && request.resource.data.teacherFeedback == resource.data.teacherFeedback
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.quizId == resource.data.quizId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.attemptNumber == resource.data.attemptNumber + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'score', 'totalPoints', 'userAnswers', 'completedAt', 'timeSpent',
            'passingPercentage', 'retryAllowed', 'attemptNumber'
          ])
          && activeClass(resource.data.classId))
      );
      allow delete: if false;
    }
    match /students/{uid}/{subcollection}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // CSS gradebooks are scoped to the authenticated teacher, never client-
    // supplied ownership. Profiles are immutable once configured. Records store
    // component totals; computed grades are derived using the versioned policy.
    function gradebookStaff(teacherId, classId) {
      let classroom = get(/databases/$(database)/documents/classes/$(classId)).data;
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && classroom.teacherId == teacherId
        && profile.get('isActive', true) == true
        && profile.role == 'teacher' && request.auth.uid == teacherId;
    }
    function validGradeScore(score) {
      return score is map && score.keys().hasAll(['raw', 'maximum'])
        && score.keys().hasOnly(['raw', 'maximum'])
        && score.raw is number && score.maximum is number
        && score.maximum > 0 && score.maximum <= 1000000
        && score.raw >= 0 && score.raw <= score.maximum;
    }
    function validGradeScores(scores) {
      return scores is map && scores.keys().hasOnly(['quiz', 'simulation', 'assignment', 'ww', 'pt', 'st1', 'st2', 'te'])
        && (!('quiz' in scores) || validGradeScore(scores.quiz))
        && (!('simulation' in scores) || validGradeScore(scores.simulation))
        && (!('assignment' in scores) || validGradeScore(scores.assignment))
        && (!('ww' in scores) || validGradeScore(scores.ww))
        && (!('pt' in scores) || validGradeScore(scores.pt))
        && (!('st1' in scores) || validGradeScore(scores.st1))
        && (!('st2' in scores) || validGradeScore(scores.st2))
        && (!('te' in scores) || validGradeScore(scores.te));
    }
    match /css_gradebooks/{teacherId}/classes/{classId} {
      allow read: if gradebookStaff(teacherId, classId);
      allow create: if gradebookStaff(teacherId, classId)
        && request.resource.data.keys().hasOnly(['profile', 'year', 'updatedAt'])
        && request.resource.data.profile == 'techPro'
        && request.resource.data.year is int
        && request.resource.data.year >= 2026 && request.resource.data.year <= 2100
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
      match /records/{recordId} {
        allow read: if gradebookStaff(teacherId, classId);
        allow create, update: if gradebookStaff(teacherId, classId)
          && exists(/databases/$(database)/documents/css_gradebooks/$(teacherId)/classes/$(classId))
          && request.resource.data.keys().hasOnly(['studentId', 'term', 'scores', 'updatedAt'])
          && request.resource.data.studentId is string
          && request.resource.data.studentId.size() > 0 && request.resource.data.studentId.size() <= 128
          && request.resource.data.studentId in get(/databases/$(database)/documents/classes/$(classId)).data.enrolledStudentIds
          && request.resource.data.term is int && request.resource.data.term in [1, 2, 3]
          && recordId == request.resource.data.studentId + '_' + string(request.resource.data.term)
          && validGradeScores(request.resource.data.scores)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }
    // Trainer grades are intentionally stored in a separate namespace. An
    // assigned trainer can only manage their own enrolled learners.
    function trainerGradebookStaff(trainerId, classId) {
      let classroom = get(/databases/$(database)/documents/classes/$(classId)).data;
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && request.auth.uid == trainerId
        && profile.get('isActive', true) == true && profile.role == 'trainer'
        && trainerId in classroom.get('trainerIds', []);
    }
    match /trainer_gradebooks/{trainerId}/classes/{classId} {
      allow read: if trainerGradebookStaff(trainerId, classId);
      allow create: if trainerGradebookStaff(trainerId, classId)
        && request.resource.data.keys().hasOnly(['profile', 'year', 'updatedAt'])
        && request.resource.data.profile == 'techPro'
        && request.resource.data.year is int
        && request.resource.data.year >= 2026 && request.resource.data.year <= 2100
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
      match /records/{recordId} {
        allow read: if trainerGradebookStaff(trainerId, classId);
        allow create, update: if trainerGradebookStaff(trainerId, classId)
          && exists(/databases/$(database)/documents/trainer_gradebooks/$(trainerId)/classes/$(classId))
          && request.resource.data.keys().hasOnly(['studentId', 'term', 'scores', 'updatedAt'])
          && request.resource.data.studentId is string
          && request.resource.data.studentId.size() > 0 && request.resource.data.studentId.size() <= 128
          && request.resource.data.studentId in get(/databases/$(database)/documents/classes/$(classId)).data.enrolledStudentIds
          && request.resource.data.term is int && request.resource.data.term in [1, 2, 3]
          && recordId == request.resource.data.studentId + '_' + string(request.resource.data.term)
          && validGradeScores(request.resource.data.scores)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }
    function validClassRoster(data) {
      return data.enrolledStudentIds is list && data.enrolledStudentIds.size() <= 1000
        && data.get('description', '') is string && data.get('description', '').size() <= 5000
        && data.get('studentCount', 0) is int && data.get('studentCount', 0) >= 0 && data.get('studentCount', 0) <= 1000
        && data.get('pendingReviews', 0) is int && data.get('pendingReviews', 0) >= 0;
    }
    function validPrincipalClass(data) {
      return validClassRoster(data) && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.sectionCode is string && data.sectionCode.size() > 0 && data.sectionCode.size() <= 60
        && data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 128
        && get(/databases/$(database)/documents/users/$(data.teacherId)).data.role == 'teacher'
        && data.schoolYear is string && data.schoolYear.size() > 0 && data.schoolYear.size() <= 32
        && data.status in ['active', 'archived']
        && data.enrolledStudentIds is list && data.enrolledStudentIds.size() <= 1000
        && data.get('trainerIds', []) is list && data.get('trainerIds', []).size() <= 100;
    }
    function principalArchivesClass() {
      return canAdmin()
        && resource.data.schoolYear is string
        && resource.data.schoolYear.matches('^[0-9]{4}-[0-9]{4}$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'archivedAt', 'archiveSchoolYear', 'archiveReason'
        ])
        && request.resource.data.status == 'archived'
        && request.resource.data.archivedAt is timestamp
        && request.resource.data.archiveSchoolYear == resource.data.schoolYear
        && request.resource.data.archiveReason is string
        && request.resource.data.archiveReason.size() > 0
        && request.resource.data.archiveReason.size() <= 200;
    }
    function classParticipant(classId) {
      let classroom = get(/databases/$(database)/documents/classes/$(classId)).data;
      return request.auth != null && (canAdmin() || (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
        && (classroom.teacherId == request.auth.uid
          || request.auth.uid in classroom.get('trainerIds', [])
          || request.auth.uid in classroom.get('enrolledStudentIds', []))));
    }
    function activeClass(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data.status == 'active';
    }
    function classStaff(classId) {
      let classroom = get(/databases/$(database)/documents/classes/$(classId)).data;
      return request.auth != null && (canAdmin()
        || (isActiveTeacher() && classroom.teacherId == request.auth.uid)
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
          && request.auth.uid in classroom.get('trainerIds', [])));
    }
    function classContentStaff(classId) {
      let classroom = get(/databases/$(database)/documents/classes/$(classId)).data;
      return request.auth != null && (
        (isActiveTeacher() && classroom.teacherId == request.auth.uid)
        || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
          && request.auth.uid in classroom.get('trainerIds', [])));
    }
    function studentJoinsSelf(classId) {
      let before = resource.data.get('enrolledStudentIds', []);
      let after = request.resource.data.enrolledStudentIds;
      let membership = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/classes/$(classId)).data;
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true
        && resource.data.status == 'active'
        && !(request.auth.uid in before)
        && request.auth.uid in after
        // Joining is authorized by the membership written in the same atomic
        // batch. A roster-only update cannot bypass the submitted class code.
        && membership.classId == classId
        && membership.classCode == resource.data.classCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudentIds', 'updatedAt'])
        && after is list && after.size() <= 1000
        && after.size() == after.toSet().size()
        && after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
        && before.toSet().difference(after.toSet()).hasOnly([]);
    }
    function studentLeavesSelf(classId) {
      let before = resource.data.get('enrolledStudentIds', []);
      let after = request.resource.data.enrolledStudentIds;
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
        && request.auth.uid in before
        && !(request.auth.uid in after)
        // Leaving is permitted for active and archived classes, but only when
        // the same atomic batch deletes both student membership documents.
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/classes/$(classId))
        && !existsAfter(/databases/$(database)/documents/classes/$(classId)/students/$(request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudentIds', 'updatedAt'])
        && after is list && after.size() <= 1000
        && after.size() == after.toSet().size()
        && after.toSet().difference(before.toSet()).hasOnly([])
        && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow create: if canAdmin() && validPrincipalClass(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && (
        (canAdmin() && validPrincipalClass(request.resource.data))
        || principalArchivesClass()
        || (isActiveTeacher() && ownsClass(classId) && validClassRoster(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'description', 'enrolledStudentIds', 'studentCount', 'pendingReviews', 'updatedAt']))
        || studentJoinsSelf(classId)
        || studentLeavesSelf(classId));
      allow delete: if canAdmin();
      match /students/{studentId} {
        allow create, update: if request.auth != null
          && request.auth.uid == studentId
          && get(/databases/$(database)/documents/users/$(studentId)).data.role == 'student'
          && get(/databases/$(database)/documents/users/$(studentId)).data.get('isActive', true) == true
          && get(/databases/$(database)/documents/classes/$(classId)).data.status == 'active'
          && studentId in getAfter(/databases/$(database)/documents/classes/$(classId)).data.enrolledStudentIds
          && getAfter(/databases/$(database)/documents/users/$(studentId)/classes/$(classId)).data.classCode
            == get(/databases/$(database)/documents/classes/$(classId)).data.classCode
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'joinedAt', 'status'])
          && request.resource.data.uid == studentId
          && request.resource.data.role == 'student'
          && request.resource.data.name is string && request.resource.data.name.size() <= 200
          && request.resource.data.email == get(/databases/$(database)/documents/users/$(studentId)).data.email
          && request.resource.data.status == 'active'
          && request.resource.data.joinedAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == studentId
          && get(/databases/$(database)/documents/users/$(studentId)).data.role == 'student'
          && !(studentId in getAfter(/databases/$(database)/documents/classes/$(classId)).data.enrolledStudentIds);
      }
      match /forum_posts/{document=**} {
        allow read: if classParticipant(classId);
        allow write: if classStaff(classId)
          || (classParticipant(classId) && activeClass(classId));
      }
      match /module_access/{accessId} {
        allow read: if classParticipant(classId);
        allow create, update: if classStaff(classId) || (classParticipant(classId)
          && request.resource.data.studentId == request.auth.uid);
        allow delete: if classStaff(classId);
      }
      match /{subcollection}/{document=**} {
        allow read: if classParticipant(classId);
        allow write: if (
          subcollection in ['modules', 'quizzes', 'assignments']
          && classContentStaff(classId)
        ) || (
          !(subcollection in ['modules', 'quizzes', 'assignments'])
          && classStaff(classId)
        );
      }
    }
    function validArchiveYear(data, schoolYear) {
      return data.keys().hasOnly([
          'name', 'schoolYear', 'status', 'classCount', 'dataLocation',
          'dataPreservedInSource', 'updatedAt'
        ])
        && schoolYear.matches('^[0-9]{4}-[0-9]{4}$')
        && data.name == schoolYear
        && data.schoolYear == schoolYear
        && data.status == 'archived'
        && data.classCount is int && data.classCount >= 0 && data.classCount <= 1000
        && data.dataLocation == 'classes and their nested subcollections'
        && data.dataPreservedInSource == true
        && data.updatedAt is timestamp;
    }
    function validArchiveClass(data, schoolYear, classId) {
      return data.keys().hasOnly([
          'classId', 'className', 'sectionCode', 'teacherId', 'teacherName',
          'schoolYear', 'sourcePath', 'archivedAt', 'dataPreservedInSource'
        ])
        && data.classId == classId
        && data.className is string && data.className.size() > 0 && data.className.size() <= 100
        && data.sectionCode is string && data.sectionCode.size() <= 60
        && data.teacherId is string && data.teacherId.size() <= 128
        && data.teacherName is string && data.teacherName.size() <= 200
        && data.schoolYear == schoolYear
        && data.sourcePath == 'classes/' + classId
        && data.archivedAt is timestamp
        && data.dataPreservedInSource == true;
    }
    // The scheduled Admin SDK rollover and the principal's explicit rollover
    // create the same validated archive index. Source class data is preserved.
    match /school_year_archives/{schoolYear} {
      allow read: if canAdmin();
      allow create, update: if canAdmin()
        && validArchiveYear(request.resource.data, schoolYear);
      allow delete: if false;
      match /classes/{classId} {
        allow read: if canAdmin();
        allow create, update: if canAdmin()
          && validArchiveClass(request.resource.data, schoolYear, classId);
        allow delete: if false;
      }
    }
    // Academic-year and school-profile settings affect every account. They
    // are readable in reports, but only the principal may change them.
    function validAcademicYear() {
      return request.resource.data.startYear is int
        && request.resource.data.endYear is int
        && request.resource.data.activeSchoolYear is string
        && request.resource.data.activeSchoolYear.matches('^[0-9]{4}-[0-9]{4}$')
        // January-May still belongs to the year that began the previous June.
        && ((request.time.month() < 6
              && request.resource.data.startYear >= request.time.year() - 1)
          || (request.time.month() >= 6
              && request.resource.data.startYear >= request.time.year()))
        && request.resource.data.startYear < 9999
        && request.resource.data.endYear == request.resource.data.startYear + 1;
    }
    match /system_settings/{documentId} {
      allow read: if request.auth != null;
      allow write: if canAdmin()
        && (documentId != 'academic_year' || validAcademicYear());
    }
    match /settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if canAdmin();
    }
    match /quiz_results/{resultId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && classParticipant(request.resource.data.classId)
        && activeClass(request.resource.data.classId)
        && request.resource.data.quizId is string
        && resultId == request.resource.data.quizId + '_' + request.auth.uid;
      allow update: if request.auth != null && (
        (classStaff(resource.data.classId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'retryAllowed', 'teacherFeedback', 'retryAllowedAt', 'attemptNumber'
          ])
          && request.resource.data.retryAllowed == true
          && request.resource.data.teacherFeedback is string
          && request.resource.data.teacherFeedback.size() > 0
          && request.resource.data.teacherFeedback.size() <= 1000
          && request.resource.data.retryAllowedAt is timestamp
          && request.resource.data.attemptNumber is int
          && request.resource.data.attemptNumber >= 1
          && request.resource.data.attemptNumber <= 100)
        ||
        (resource.data.studentId == request.auth.uid
          && resultId == resource.data.quizId + '_' + request.auth.uid
          && resource.data.retryAllowed == true
          && request.resource.data.retryAllowed == false
          && request.resource.data.teacherFeedback == resource.data.teacherFeedback
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.quizId == resource.data.quizId
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.attemptNumber == resource.data.attemptNumber + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'score', 'totalPoints', 'userAnswers', 'completedAt', 'timeSpent',
            'passingPercentage', 'retryAllowed', 'attemptNumber'
          ])
          && activeClass(resource.data.classId))
      );
      allow delete: if false;
    }
    match /pre_assessments/{resultId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && resultId == request.auth.uid + '_' + request.resource.data.classId;
      allow update, delete: if false;
    }
    match /activity_events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && (activeClass(request.resource.data.classId)
          || (request.resource.data.mode == 'practice'
            && classParticipant(request.resource.data.classId)));
      allow update, delete: if false;
    }
    match /submissions/{submissionId} {
      allow read: if request.auth != null
        && (resource.data.studentId == request.auth.uid
          || classStaff(resource.data.classId));
      allow create: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.classId is string
        && request.resource.data.classId.size() > 0
        && request.resource.data.classId.size() <= 128
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() > 0
        && request.resource.data.assignmentId.size() <= 128
        && submissionId == request.resource.data.assignmentId + '_' + request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 50000
        && request.resource.data.score == 0
        && request.resource.data.isGraded == false
        && classParticipant(request.resource.data.classId)
        && activeClass(request.resource.data.classId);
      allow update: if classStaff(resource.data.classId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'score', 'feedback', 'isGraded', 'gradedAt'
        ])
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() <= 10000
        && request.resource.data.isGraded == true
        && request.resource.data.gradedAt is timestamp;
      allow delete: if false;
    }
    // Existing policies for unrelated collections remain unchanged. Exclude the
    // LRN namespace here so a broad match cannot bypass its admin restrictions.
    match /{collection}/{document=**} {
      allow read, write: if request.auth != null
        && !(collection in ['lrn_master_list', 'lrn_folders', 'users', 'students', 'css_gradebooks', 'trainer_gradebooks', 'classes', 'school_year_archives', 'system_settings', 'settings', 'quiz_results', 'pre_assessments', 'activity_events', 'submissions']);
    }
  }
}
